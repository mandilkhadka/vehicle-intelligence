# Shared local/Docker configuration.
# Docker Compose reads this file after you copy it to .env.

# -----------------------------------------------------------------------------
# Vision LLM credentials (optional but recommended)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini
INSPECTION_ANALYSIS_MIN_QUALITY=0.38

# -----------------------------------------------------------------------------
# Backend (Node + Express on :3001)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
UPLOAD_MAX_SIZE=524288000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Set to "true" only behind a trusted reverse proxy.
TRUST_PROXY=false
# Outer HTTP timeout (ms) for the ML service call. Must exceed the per-stage
# ML budget so partial-results can return.
ML_SERVICE_TIMEOUT_MS=600000
# Retention (days) for uploaded videos after the job completes. Set to 0 to disable cleanup.
VIDEO_RETENTION_DAYS=30

# Required for production: shared secret sent by backend to ML service.
# Generate with: openssl rand -base64 32
ML_SERVICE_API_KEY=
ML_SERVICE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Frontend (Next.js on :3000)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# -----------------------------------------------------------------------------
# ML service (FastAPI on :8000)
# -----------------------------------------------------------------------------
# Inference device. Leave blank for auto-detect (CUDA if available, else CPU).
# Set to "cuda", "mps", or "cpu" to force.
ML_DEVICE=
# Per-stage timeouts in seconds for the parallel ML block in process.py.
ML_STAGE_TIMEOUT_VEHICLE=60
ML_STAGE_TIMEOUT_ODOMETER=90
ML_STAGE_TIMEOUT_DAMAGE=180
ML_STAGE_TIMEOUT_EXHAUST=60
ML_STAGE_TIMEOUT_GEMINI=120
# Damage detector tuning.
ML_DAMAGE_CONFIDENCE_THRESHOLD=0.55
ML_DAMAGE_MAX_FRAMES=15
ML_DAMAGE_DEDUP_RADIUS_PX=80
ML_DAMAGE_DEDUP_FRAME_WINDOW=5
# Odometer reader tuning.
ML_ODOMETER_MAX_FRAMES=3
ML_ODOMETER_EARLY_STOP_CONFIDENCE=0.86
ML_ODOMETER_MIN_RELIABLE_CONFIDENCE=0.50
ML_ODOMETER_MAX_PLAUSIBLE=2000000
ML_ODOMETER_MIN_PLAUSIBLE=0
# Frame extraction tuning.
ML_FRAME_EXTRACTION_FPS=
ML_FRAME_BLUR_THRESHOLD=
ML_FRAME_JPEG_QUALITY=

# -----------------------------------------------------------------------------
# Shared / browser-facing
# -----------------------------------------------------------------------------
# Comma-separated allowed browser origins for backend/ML CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
