# Shared local/Docker configuration.
# Docker Compose reads this file after you copy it to .env.

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4.1-mini
INSPECTION_ANALYSIS_MIN_QUALITY=0.38

# Required for production: shared secret sent by backend to ML service.
# Generate with: openssl rand -base64 32
ML_SERVICE_API_KEY=

# Comma-separated allowed browser origins for backend/ML CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

POSTGRES_DB=vehicle_intelligence
POSTGRES_USER=vehicle_user
POSTGRES_PASSWORD=vehicle_password
REDIS_PASSWORD=
