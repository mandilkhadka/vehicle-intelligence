# ML service local configuration.
# START_SERVICES.sh and direct ml-service commands load this file and the repo root .env.

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# Local Ollama VLM/LLM (primary provider when set). The service talks to
# Ollama's NATIVE /api/chat endpoint (not the /v1 OpenAI-compat shim), which is
# reliable for vision models and forces valid JSON. When OLLAMA_BASE_URL is set,
# Ollama is tried BEFORE Gemini/OpenAI. Leave blank to disable.
#   1) ollama serve
#   2) ollama pull qwen2.5vl      # vision (damage + odometer)
#   3) ollama pull gemma2:9b      # text (report generation)
# In Docker, use http://host.docker.internal:11434 to reach Ollama on the host.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=qwen2.5vl
OLLAMA_TEXT_MODEL=gemma2:9b
# Local models can be slow on the first (cold) call; bump if you see timeouts.
OLLAMA_TIMEOUT_SECONDS=120

# Optional: tune inspection image routing without code changes.
INSPECTION_ANALYSIS_MIN_QUALITY=0.38
ML_SERVICE_API_KEY=

# Model selection — no model name is hardcoded; swap weights here.
# CLIP is used ONLY for frame selection / vehicle identification, never damage.
ML_YOLO_MODEL=yolov8n.pt
ML_CLIP_MODEL=openai/clip-vit-base-patch32

# Dedicated damage detection/segmentation model (PRIMARY damage source when
# set). Train + benchmark candidates on CarDD with ml-service/training/ (YOLO11/
# YOLO12/RT-DETR), then point this at the winning weights. Leave blank for
# VLM-only damage detection.
ML_DAMAGE_MODEL_PATH=
# auto | yolo | rtdetr ("auto" picks rtdetr when the filename contains it)
ML_DAMAGE_MODEL_ARCH=auto
ML_DAMAGE_MODEL_CONFIDENCE=0.35
ML_DAMAGE_MODEL_IOU=0.5
ML_DAMAGE_MODEL_IMGSZ=1024
# Optional JSON to map extra model classes onto the pipeline taxonomy, e.g.
# {"rust_spot": "rust"}. CarDD's 6 classes are mapped by default.
ML_DAMAGE_CLASS_MAP=

# Damage detection (VLM path). Without a dedicated model above, the VLM
# (Ollama if configured, else Gemini, with the OpenAI-compatible fallback
# above) is the authoritative damage source; with one, the VLM supplements it
# for categories outside the trained taxonomy. The legacy OpenCV heuristics
# are OFF by default — they false-positive on clean cars. Set to true only for
# offline comparison.
ML_DAMAGE_USE_CV_HEURISTICS=false
# Drop VLM damage findings below this confidence.
ML_DAMAGE_VLM_MIN_CONFIDENCE=0.55
# A damage must be seen in this many distinct frames to be reported (a
# reflection/shadow shows in one frame; real damage shows from several angles).
# Set to 1 to disable the multi-frame requirement.
ML_DAMAGE_CONSENSUS_MIN_FRAMES=2
# Escape hatch: keep a single-frame finding anyway if its confidence is this high.
ML_DAMAGE_VLM_HIGH_CONFIDENCE=0.85

MOCK_MODE=false
NODE_ENV=development
LOG_LEVEL=INFO
