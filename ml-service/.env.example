# ML service local configuration.
# START_SERVICES.sh and direct ml-service commands load this file and the repo root .env.

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Optional: tune inspection image routing without code changes.
INSPECTION_ANALYSIS_MIN_QUALITY=0.38
ML_SERVICE_API_KEY=

MOCK_MODE=false
NODE_ENV=development
LOG_LEVEL=INFO
